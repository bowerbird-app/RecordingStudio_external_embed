<% dummy_page_nav(
  title: "Config",
  subtitle: "oEmbed gateway timeouts, byte limit, and cache for RecordingStudio::ExternalEmbed.",
  back_url: root_path
) %>

<div class="flex w-full flex-col gap-6">

  <p class="text-sm leading-6 text-(--surface-muted-content-color)">
    The install generator writes
    <code class="text-(--surface-content-color)">config/initializers/recording_studio_external_embed.rb</code>.
    Use <code class="text-(--surface-content-color)">RecordingStudio::ExternalEmbed.configure</code> there to tune oEmbed
    HTTP behavior. Provider registration uses a separate initializer—see
    <%= link_to "Providers", docs_providers_path, class: "font-medium text-(--link-text-color) underline-offset-2 hover:underline" %>.
  </p>

  <p class="text-sm leading-6 text-(--surface-muted-content-color)">
    This dummy host loads
    <code class="text-(--surface-content-color)">config/initializers/recording_studio_external_embed.rb</code>
    with the timeout block below plus extra provider registrations for smoke tests (see
    <%= link_to "Providers", docs_providers_path, class: "font-medium text-(--link-text-color) underline-offset-2 hover:underline" %>).
  </p>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Initializer",
    subtitle: "Same block the generator emits for oEmbed timeouts and cache lifetime"
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # config/initializers/recording_studio_external_embed.rb
      RecordingStudio::ExternalEmbed.configure do |config|
        config.open_timeout = 1
        config.read_timeout = 2
        config.max_bytes = 65_536
        config.cache_ttl = 12.hours
      end
    CODE
  ) %>

  <p class="text-sm leading-6 text-(--surface-muted-content-color)">
    <code class="text-(--surface-content-color)">open_timeout</code> and
    <code class="text-(--surface-content-color)">read_timeout</code> are in seconds.
    <code class="text-(--surface-content-color)">max_bytes</code> caps how much of an oEmbed JSON response is read.
    <code class="text-(--surface-content-color)">cache_ttl</code> is how long a fetched oEmbed response stays in the cache.
    The default is 12 hours. A cache hit reports metadata_status fetched.
    A lookup with no metadata, a transient failure, or a permanent failure is not cached.
    <code class="text-(--surface-content-color)">cache</code> chooses the store. Leave it unset to use
    <code class="text-(--surface-content-color)">Rails.cache</code>.
    <code class="text-(--surface-content-color)">http</code>,
    <code class="text-(--surface-content-color)">resolver</code>, and
    <code class="text-(--surface-content-color)">cache</code> are runtime settings and are ignored when configuration is
    loaded from YAML. <code class="text-(--surface-content-color)">cache_ttl</code> is loaded from YAML.
  </p>
</div>
