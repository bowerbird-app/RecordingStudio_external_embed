<% dummy_page_nav(title: "External embeds", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "External embeds",
    subtitle: "A resolved YouTube URL renders in the page. An unsupported URL does not.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "YouTube",
          subtitle: "The helper builds the iframe from the resolved embed.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <%= recording_studio_external_embed("https://www.youtube.com/watch?v=dQw4w9WgXcQ") %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Unsupported URL",
          subtitle: "A lookalike host does not become an iframe.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <% rejected = RecordingStudio::ExternalEmbed.resolve("https://youtube.com.evil.example/watch?v=dQw4w9WgXcQ") %>
        <p class="text-sm leading-6"><%= rejected.errors.first %></p>
        <%= recording_studio_external_embed(rejected) %>
      <% end %>
    <% end %>
  </div>
</div>
